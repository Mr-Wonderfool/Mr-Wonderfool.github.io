source "https://rubygems.org"

# Use modern Jekyll for local preview on Ruby 3.2+ / 4.0.
# (The old github-pages gem pins Jekyll 3.9 + Liquid 4.0.3, which breaks on Ruby 4.0.)
gem "jekyll", "~> 4.4"
gem "jekyll-sitemap"
gem "webrick", "~> 1.8"

# Faster file watching on Windows
gem "wdm", ">= 0.1.0", platforms: [:windows]
